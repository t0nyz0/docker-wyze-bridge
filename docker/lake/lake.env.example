# Copy to .env.lake in the repository root. No account secrets belong here.
# Use the normalized name shown by Bridge: "Front Door" becomes front_door.
LAKE_CAMERA=front_door
LAKE_QUALITY=2k
LAKE_FPS=20
LAKE_PREVIEW_WIDTH=1920
LAKE_PREVIEW_HEIGHT=1080
WYZE_CREDENTIALS_FILE=.env.wyze
